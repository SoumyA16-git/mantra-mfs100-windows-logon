<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>MFS100BridgeSvc</AssemblyName>
    <RootNamespace>MFS100BridgeSvc</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <StartupObject>MFS100BridgeSvc.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Copy Worker executable and SDK DLLs to output directory for local testing -->
  <ItemGroup>
    <None Include="..\Worker\bin\x86\Release\net48\MFS100Worker.exe" Condition="Exists('..\Worker\bin\x86\Release\net48\MFS100Worker.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MFS100Worker.exe</Link>
    </None>
    <None Include="..\..\sdk\MFS100Dll.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MFS100Dll.dll</Link>
    </None>
    <None Include="..\..\sdk\iengine_ansi_iso.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>iengine_ansi_iso.dll</Link>
    </None>
    <None Include="..\..\sdk\MANTRA.MFS100.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MANTRA.MFS100.dll</Link>
    </None>
  </ItemGroup>

</Project>
